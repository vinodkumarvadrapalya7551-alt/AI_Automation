generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("EMPLOYEE") // EMPLOYEE | ADMIN
  department   String    @default("General")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expenses  Expense[]
  reviews   Review[]
  auditLogs AuditLog[]
}

model Expense {
  id              String   @id @default(cuid())
  userId          String
  merchant        String
  amount          Float
  tax             Float    @default(0)
  currency        String   @default("INR")
  date            String
  category        String   @default("Other")
  description     String   @default("")
  receiptNumber   String   @default("")
  paymentMethod   String   @default("")
  status          String   @default("PROCESSING") // UPLOADED|PROCESSING|EXTRACTED|VALIDATING|APPROVED|FLAGGED|REJECTED
  confidenceScore Float    @default(0)
  aiReasoning     String   @default("")
  duplicateFlag   Boolean  @default(false)
  policyFlag      Boolean  @default(false)
  flagReasons     String   @default("[]") // JSON array of flag reasons
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  receipt Receipt?
  review  Review?
}

model Receipt {
  id         String   @id @default(cuid())
  expenseId  String   @unique
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id])
}

model Policy {
  id          String   @id @default(cuid())
  name        String
  category    String   // e.g. "Meals", "Travel", "ALL"
  maxAmount   Float
  currency    String   @default("INR")
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  expenseId  String   @unique
  adminId    String
  decision   String   // APPROVED | REJECTED
  reason     String   @default("")
  reviewedAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id])
  admin   User    @relation(fields: [adminId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String
  metadata  String   @default("{}")
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
